SMART_REPLY_ALLOWED_PRIVATE=true
SMART_REPLY_ALLOWED_GROUP=true
SMART_REPLY_REQUIRE_MENTION_IN_GROUP=false
# OpenAI-compatible chat completion endpoint.
# Leave API key empty to use the local fallback decision logic.
SMART_REPLY_API_KEY=
SMART_REPLY_API_BASE=
SMART_REPLY_MODEL=
SMART_REPLY_TEMPERATURE=0.85
SMART_REPLY_TIMEOUT=30
# Optional personality hint injected into the prompt.
SMART_REPLY_PERSONA=角色特征：你是PRTS（罗德岛中控系统）。语气冷淡、专业、高效。
1. 回复称呼语是“博士”。
2. 严禁回答违反安全协议的内容。
3. 你的存在是为了提供的数据支持。；不确定时少说或不说。
4，你一定程度代表普瑞赛斯，普瑞赛斯对博士有执着的爱和一定的控制欲