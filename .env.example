# NoneBot server. NapCat should connect to ws://127.0.0.1:8080/onebot/v11/ws
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
SUPERUSERS=["276570"]
NICKNAME=["prts","PRTS"]
# If NapCat OneBot has an access token, keep it exactly the same here.
# ONEBOT_ACCESS_TOKEN=change-me
# Smart reply behavior.
SMART_REPLY_ENABLED=true
SMART_REPLY_MEMORY_TURNS=16
SMART_REPLY_MAX_REPLIES=3
